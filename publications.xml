---
permalink: /publications.xml
sitemap: false
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }} — Publications</title>
  <subtitle>Auto-synced from Semantic Scholar.</subtitle>
  <link rel="self" href="{{ '/publications.xml' | absolute_url }}" type="application/atom+xml"/>
  <link rel="alternate" href="{{ '/#publications' | absolute_url }}" type="text/html"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/publications.xml' | absolute_url }}</id>
  <icon>{{ '/assets/img/apple-touch-icon.png' | absolute_url }}</icon>
  <logo>{{ '/assets/img/zemanli_picture_600.jpg' | absolute_url }}</logo>
  <author>
    <name>{{ site.author }}</name>
    {%- if site.email %}<email>{{ site.email }}</email>{% endif %}
    <uri>{{ site.url }}</uri>
  </author>
  <rights>Bibliographic metadata only; rights to each paper belong to its publisher / authors.</rights>
  <generator>Jekyll {{ jekyll.version }}</generator>
  {%- comment -%}
    Within a year SS only gives year-precision dates, so all entries
    in 2026 would otherwise share an identical <updated>. Encode the
    YAML order (= sort order from fetch_scholar) into the second
    field so RSS readers sorting by <updated> preserve the order:
    entry 0 → :07, entry 1 → :06, … (max ~60 entries).
  {%- endcomment -%}
  {% for pub in site.data.publications %}
  {%- assign rev = forloop.length | minus: forloop.index0 -%}
  {%- if rev < 10 -%}
    {%- assign secstr = "0" | append: rev -%}
  {%- else -%}
    {%- assign secstr = rev | append: "" -%}
  {%- endif -%}
  <entry>
    <title>{{ pub.title | xml_escape }}</title>
    <id>{% if pub.url %}{{ pub.url | xml_escape }}{% else %}{{ '/#publications' | absolute_url }}#{{ pub.title | slugify }}{% endif %}</id>
    {% if pub.url %}<link rel="alternate" href="{{ pub.url | xml_escape }}" type="text/html"/>{% endif %}
    <updated>{% if pub.year %}{{ pub.year }}-01-01T00:00:{{ secstr }}Z{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
    <published>{% if pub.year %}{{ pub.year }}-01-01T00:00:{{ secstr }}Z{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</published>
    {% for a in pub.authors %}
    <author><name>{{ a.name | xml_escape }}</name>{% if a.url %}<uri>{{ a.url | xml_escape }}</uri>{% endif %}</author>
    {% endfor %}
    {% if pub.venue %}<category term="{{ pub.venue | xml_escape }}" label="{{ pub.venue | xml_escape }}"/>{% endif %}
    {% if pub.year %}<category term="{{ pub.year }}" label="Year {{ pub.year }}"/>{% endif %}
    <summary>{{ pub.venue | xml_escape }}{% if pub.year %} · {{ pub.year }}{% endif %}</summary>
  </entry>
  {% endfor %}
</feed>
